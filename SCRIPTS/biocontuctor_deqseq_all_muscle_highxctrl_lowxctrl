R

install.packages("BiocManager")

library(org.Mm.eg.db)
library(AnnotationDbi)

BiocManager::install("DESeq2")
library(DESeq2)
## 1) Listar arquivos de contagem
## Seus arquivos terminam com: _Star_Aligned.out.bam_all.txt
files_all <- list.files(".", pattern="Star_Aligned.out.bam_all.txt")
files_high <- files_all[!grepl("LOW", files_all)]

## Verificar se encontrou os 9 arquivos
print(files_high)
print(length(files_high))

## 4) Ler cada arquivo e extrair apenas a coluna de counts
## featureCounts gera 7 colunas:
## Geneid | Chr | Start | End | Strand | Length | counts
## A última coluna é sempre o count da amostra
cts_high <- lapply(files_high, function(f) {
  x <- read.table(f, header=TRUE, row.names=1)
  x[, ncol(x), drop=FALSE]   # mantém só a coluna de counts
})
####ver colunas
for (i in seq_along(cts_high)) {
  cat(files_high[i], ": ", ncol(cts_high[[i]]), " colunas\n", sep = "")
}
###ver nome das col;unas
for (i in seq_along(cts_high)) {
  cat(files_high[i], ": ", colnames(cts_high[[i]]), "\n", sep = "")
}

## 5) Combinar todas as colunas de counts em uma matriz
cts_high <- do.call(cbind, cts_high)

## 6) Nomear colunas com o nome da amostra (removendo o sufixo do arquivo)
colnames(cts_high) <- gsub("_Star_Aligned.out.bam_all.txt", "", files_high)

## Conferir estrutura final
colnames(cts_high)
head(cts_high)

###############################################
## 7) Criar colData automaticamente pelo nome ##
###############################################

sample_names <- colnames(cts_high)

## condition

condition <- ifelse(grepl("CTRL", sample_names, ignore.case=TRUE), "CTRL",
         ifelse(grepl("LOW",  sample_names, ignore.case=TRUE), "LOW",
         ifelse(grepl("HIGH", sample_names, ignore.case=TRUE), "HIGH", NA)))

condition
table(condition)

## tissue
tissue <- ifelse(grepl("Adipose", sample_names), "Adipose",
          ifelse(grepl("Duodenum", sample_names), "Duodenum",
          ifelse(grepl("Kidney", sample_names), "Kidney",
          ifelse(grepl("Liver", sample_names), "Liver",
          ifelse(grepl("Muscle", sample_names), "Muscle", NA)))))

tissue
table(tissue)

#type
type <- rep("paired-end", length(sample_names))
type <- factor(type)

#colData
colData_high <- data.frame(
  row.names = sample_names,
  condition = factor(condition, levels = c("CTRL","HIGH")),
  tissue    = factor(tissue),
  type = type
)

colData_high$condition <- factor(colData_high$condition)
colData_high$type <- factor(colData_high$type)


print(colData_high)
all(rownames(colData_high) == colnames(cts_high))
#########################################
## 8) Criar objeto DESeq2 e rodar DESeq ##
#########################################

## Aqui você NÃO define contrastes.
## Aqui você só ajusta o modelo estatístico.
## O DESeq() prepara tudo para os contrastes,
## mas não calcula log2FC ainda.

dds_global_high <- DESeqDataSetFromMatrix(
  countData = cts_high,
  colData = colData_high,
  design = ~ condition
)

dds_global_high <- estimateSizeFactors(dds_global_high)

##Subset por tecido
dds_muscle_high <- dds_global_high[, dds_global_high$tissue == "Muscle"]

#Prefiltrar genes (≥10 counts em ≥3 amostras)
smallestGroupSize <- 3
keep <- rowSums(counts(dds_muscle_high) >= 10) >= smallestGroupSize
dds_muscle_high <- dds_muscle_high[keep, ]
dds_muscle_high

######Note on factor leves/Relevel#####
dds_muscle_high$condition <- relevel(dds_muscle_high$condition, ref = "CTRL")

#Rodar DESeq no subset
dds_muscle_high <- DESeq(dds_muscle_high)

dds_muscle_high
mcols(dds_muscle_high)

## 9) Extrair resultados dos dois contrastes do seu estudo ##
###########################################################

## Aqui SIM você define os contrastes explicitamente.

## HIGH vs CTRL
res_high <- results(dds_muscle_high, contrast = c("condition", "HIGH", "CTRL"))
res_high

####Shrink#######################################################
install.packages("ashr")

resultsNames(dds_muscle_high)

res_high_lfc <- lfcShrink(
  dds_muscle_high,
  coef = "condition_HIGH_vs_CTRL",
  type = "ashr"
)
res_high_lfc

###
summary(res_high_lfc)
length(res_high_lfc)

sum(res_high_lfc$padj < 0.1, na.rm=TRUE)

#Normalized counts
norm_counts_high <- counts(dds_muscle_high, normalized = TRUE)

norm_counts_high_df <- data.frame(
  gene = rownames(norm_counts_high),
  norm_counts_high
)

write.csv(
  norm_counts_high_df,
  file = "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/normalizedcounts_muscle_highxctrl.csv",
  row.names = FALSE
)

head(read.csv("/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/normalizedcounts_muscle_highxctrl.csv"))

# IDs originais (com versão)
ids_original_high <- rownames(res_high_lfc)

# IDs sem versão (para mapIds)
ids_clean_high <- gsub("\\..*", "", ids_original_high)

#Mapear símbolos usando os IDs limpos
symbols <- mapIds(
  org.Mm.eg.db,
  keys = ids_clean_high,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first"
)

#Adicionar símbolo ao seu resultado shrink sem alterar o ID original
res_high_lfc$symbol <- symbols

#remover genes symbolo (NA)
res_high_lfc_ordered <- res_high_lfc[!is.na(res_high_lfc$symbol), ]

#ordenar por padj
res_high_lfc_ordered <- res_high_lfc_ordered[order(res_high_lfc_ordered$padj), ]

#salvar
write.csv(
  as.data.frame(res_high_lfc_ordered),
  file = "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/allgenes_muscle_highxctrl10.csv",
  row.names = TRUE
)

# Criar versão filtrada para significantes
res_high_lfc_sig <- res_high_lfc_ordered

# Remover padj NA (somente para significantes)
res_high_lfc_sig <- res_high_lfc_sig[!is.na(res_high_lfc_sig$padj), ]

# Filtrar significantes
sig_high <- res_high_lfc_sig[res_high_lfc_sig$padj < 0.05, ]

# Já está ordenado, porque veio de res_high_lfc_ordered
# Mas se quiser garantir:
sig_high <- sig_high[order(sig_high$padj), ]

write.csv(
  as.data.frame(sig_high),
  file = "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/significantgenes_muscle_highxctrl2.csv",
  row.names = TRUE
)

