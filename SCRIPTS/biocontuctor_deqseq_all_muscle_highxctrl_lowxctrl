 write.csv(entrez_ids_low_up, "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_low_up_genes_kegg.csv")
 write.csv(entrez_ids_low_down, "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_low_down_genes_kegg.csv")


######## perform KEGG enrichment analysis ## RPT RPT RPT ####
kegg_enrichment <- enrichKEGG(
    gene            = entrez_ids,     # use entrez ids
    organism        = "mmu",          # mouse
    pvalueCutoff    = 0.1,            # adjusted p-value cutoff
    qvalueCutoff    = 1               # q-value cutoff
)

# save results and send to desired folder 

write.csv(
    as.data.frame(kegg_enrichment),
    "/group/sbms006/rrubimsilvadocouto/KEGG_analysis/muscle/muscle_10_common_up_genes_kegg_enrichment_results.csv",
    row.names = FALSE # to remove first column
)

