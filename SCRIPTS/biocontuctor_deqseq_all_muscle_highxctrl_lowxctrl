 write.csv(entrez_ids_high_all, "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_high_all_genes_kegg.csv")
 write.csv(entrez_ids_high_up , "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_high_up_genes_kegg.csv")
 write.csv(entrez_ids_high_down, "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_high_down_genes_kegg.csv")

### LOW — ALL
low_all <- sig_low_clean$symbol[
  sig_low_clean$padj < 0.05 &
  abs(sig_low_clean$log2FoldChange) > 1
]

### LOW — UP
low_up <- sig_low_clean$symbol[
  sig_low_clean$padj < 0.05 &
