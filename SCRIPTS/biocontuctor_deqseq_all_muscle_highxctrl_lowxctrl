#check high data#
colnames(sig_high)
head(sig_high)
nrow(sig_high)
length(sig_high)

#check low data#
colnames(sig_low)
head(sig_low)
nrow(sig_low)
length(sig_low)

# criar vetor único de todos genes significantes, não apenas separado por UP/DOWN.
#remover NAs#
sig_high_clean <- sig_high[!is.na(sig_high$padj) & !is.na(sig_high$log2FoldChange), ]
sig_low_clean  <- sig_low[!is.na(sig_low$padj) & !is.na(sig_low$log2FoldChange), ]

# HIGH and LOW (padj < 0.05, log2FC > 1)
## HIGH — ALL
high_all <- sig_high_clean$symbol[
  sig_high_clean$padj < 0.05 &
  abs(sig_high_clean$log2FoldChange) > 1
]

## HIGH — UP
high_up <- sig_high_clean$symbol[
  sig_high_clean$padj < 0.05 &
  sig_high_clean$log2FoldChange > 1
]

## HIGH — DOWN
high_down <- sig_high_clean$symbol[
  sig_high_clean$padj < 0.05 &
  sig_high_clean$log2FoldChange < -1
]

### Extrair gene symbols#
genesymbols_high_all  <- high_all
genesymbols_high_up   <- high_up
genesymbols_high_down <- high_down

## LOW — ALL
low_all <- sig_low_clean$symbol[
  sig_low_clean$padj < 0.05 &
  abs(sig_low_clean$log2FoldChange) > 1
]

## LOW — UP
low_up <- sig_low_clean$symbol[
  sig_low_clean$padj < 0.05 &
  sig_low_clean$log2FoldChange > 1
]

## LOW — DOWN
low_down <- sig_low_clean$symbol[
  sig_low_clean$padj < 0.05 &
  sig_low_clean$log2FoldChange < -1
]

### Extrair gene symbols#
genesymbols_low_all  <- low_all
genesymbols_low_up   <- low_up
genesymbols_low_down <- low_down

#intersect
inter_all  <- intersect(high_all,  low_all)
inter_up   <- intersect(high_up,   low_up)
inter_down <- intersect(high_down, low_down)

### Extrair gene symbols#
genesymbols_inter_all  <- inter_all
genesymbols_inter_up   <- inter_up
genesymbols_inter_down <- inter_down

### Map gene symbol to Entrez IDs ####
# high all#
entrez_ids_high_all <- mapIds(
  org.Mm.eg.db,
  keys = genesymbols_high_all,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)

entrez_ids_high_all <- na.omit(entrez_ids_high_all)

#high_up#
entrez_ids_high_up <- mapIds(
  org.Mm.eg.db,
  keys = genesymbols_high_up,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)
entrez_ids_high_up <- na.omit(entrez_ids_high_up)

#high_down#
entrez_ids_high_down <- mapIds(
  org.Mm.eg.db,
  keys = genesymbols_high_down,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)
entrez_ids_high_down <- na.omit(entrez_ids_high_down)

