  org.Mm.eg.db,
  keys = low_all,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)

entrez_low_up <- mapIds(
  org.Mm.eg.db,
  keys = low_up,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)

entrez_low_down <- mapIds(
  org.Mm.eg.db,
  keys = low_down,
  column = "ENTREZID",
  keytype = "SYMBOL",
  multiVals = "first"
)

### Criar data.frame com duas colunas SEMPRE
make_df <- function(symbols, entrez) {
  data.frame(
    SYMBOL   = symbols,
    ENTREZID = as.character(entrez[symbols]),
    stringsAsFactors = FALSE
  )
}

df_low_all  <- make_df(low_all,  entrez_low_all)
df_low_up   <- make_df(low_up,   entrez_low_up)
df_low_down <- make_df(low_down, entrez_low_down)

### Remover genes sem ENTREZID (opcional)
df_low_all  <- df_low_all[!is.na(df_low_all$ENTREZID), ]
df_low_up   <- df_low_up[!is.na(df_low_up$ENTREZID), ]
df_low_down <- df_low_down[!is.na(df_low_down$ENTREZID), ]

### Salvar CSVs
write.csv(df_low_all,
  "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_low_all_genes_kegg.csv",
  row.names = FALSE)

write.csv(df_low_up,
  "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_low_up_genes_kegg.csv",
  row.names = FALSE)

write.csv(df_low_down,
  "/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/muscle_low_down_genes_kegg.csv",
  row.names = FALSE)


