## VENN DIAGRAM ##
# HIGH x CTRL #
# Primeiro: transformar sua lista em vetor de nomes #
sig_high_vec <- rownames(sig_high)

# Segundo: filtrar por log2FC ≥ 1 usando o vetor #
sig_high_log2fc <- sig_high_vec[
  abs(res_high_lfc[sig_high_vec, "log2FoldChange"]) >= 1
]

# LOW x CTRL #
# Primeiro: transformar sua lista em vetor de nomes #
sig_low_vec <- rownames(sig_low)

# Segundo: filtrar por log2FC ≥ 1 usando o vetor #
sig_low_log2fc <- sig_low_vec[
  abs(res_low_lfc[sig_low_vec, "log2FoldChange"]) >= 1
]

# Conferir
length(sig_high_log2fc)
length(sig_low_log2fc)

## criar UP and DOWN ##
# HIGH #

sig_high_up <- sig_high_vec[
  res_high_lfc[sig_high_vec, "log2FoldChange"] >= 1
]

sig_high_down <- sig_high_vec[
  res_high_lfc[sig_high_vec, "log2FoldChange"] <= -1
]

# LOW #
sig_low_up <- sig_low_vec[
  res_low_lfc[sig_low_vec, "log2FoldChange"] >= 1
]

sig_low_down <- sig_low_vec[
  res_low_lfc[sig_low_vec, "log2FoldChange"] <= -1
]

###
library(VennDiagram)
library(grid)

vd4 <- venn.diagram(
  x = list(
    HIGH_UP   = sig_high_up,
    HIGH_DOWN = sig_high_down,
    LOW_UP    = sig_low_up,
    LOW_DOWN  = sig_low_down
  ),
  filename = NULL,
  fill = c("red", "blue", "green", "yellow"),
  alpha = 0.5,
  cex = 2.0,
  cat.cex = 1.5,
  main.cex = 2.0,
  cat.pos = c(-20, 20, 0, 0),
  cat.dist = c(0.20, 0.20, 0.11, 0.11),
  margin = 0.03,
  main = "Muscle: HIGH vs LOW - UP & DOWN (log2FC >= 1)"
)

grid.draw(vd4)

###### SALVAR VENN
png("/group/sbms006/rrubimsilvadocouto/NovaSeq_Data/gene-counts-S637-S633/muscle2/venn4_muscle_high_low_up_down7.png",
    width = 3500, height = 3000, res = 300)

grid.draw(vd4)

dev.off()



